              },
              {
                "id": "i_300fd73c1942",
                "title": "Opinion: Why materials control will matter as Norway scales offshore wind",
                "url": "https://energywatch.com/EnergyNews/Policy___Trading/article19817039.ece",
                "source": "energywatch.com",
                "summary": "Storage capacity that was sufficient for one project can quickly become a bottleneck once several overlap. Materials become harder to track, preservation standards can vary between sites, and existing storage may not be designed for the size or volume of components moving through offshore wind projects. [...] With plans to allocate areas for 30GW of offshore wind by 2040, that ambition is beginning to take shape. The first commercial-scale project area at Sørlige Nordsjø II was awarded to Ventyr in 2024, followed by two project areas at Utsira Nord in 2025. But as more projects move forward, pressure will build on the ports, vessels, storage capacity, specialist resources and the logistics networks connecting them.",
                "relevance_score": 0.6493563,
                "provenance": {
                  "query_ids": [
                    "q1"
                  ],
                  "occurrence_count": 1,
                  "occurrences": [
                    {
                      "query_id": "q1",
                      "url": "https://energywatch.com/EnergyNews/Policy___Trading/article19817039.ece",
                      "rank": 2,
                      "relevance_score": 0.6493563,
                      "removed_tracking_fields": []
                    }
                  ],
                  "truncated": false
