              },
              {
                "id": "i_aec978edff70",
                "title": "Wind West - Nova Scotia’s offshore wind gamble with Ottawa’s money: Edgardo Sepulveda | Macdonald-Laurier Institute",
                "url": "https://macdonaldlaurier.ca/wind-west-nova-scotias-offshore-wind-gamble-with-ottawas-money-edgardo-sepulveda",
                "source": "macdonaldlaurier.ca",
                "summary": "A common narrative is that wind power is relatively cheap, even before accounting for the system costs it imposes, including transmission and backup for its intermittency. As Figure 1 highlights, that may have been true for OFW in Europe from about 2017 to 2022, but it is no longer.",
                "relevance_score": 0.545891,
                "provenance": {
                  "query_ids": [
                    "q_cd775ed81cd2"
                  ],
                  "occurrence_count": 1,
                  "occurrences": [
                    {
                      "query_id": "q_cd775ed81cd2",
                      "url": "https://macdonaldlaurier.ca/wind-west-nova-scotias-offshore-wind-gamble-with-ottawas-money-edgardo-sepulveda",
                      "rank": 1,
                      "relevance_score": 0.545891,
                      "removed_tracking_fields": []
